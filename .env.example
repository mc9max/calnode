# Calnode — lean, self-hostable Calendly alternative
# Single Go binary + embedded SQLite (pure-Go, no CGO, no Postgres, no Redis).
# Apache-2.0. One binary, one file. docker run it or drop it on a VPS.

# ---------------------------------------------------------------- required --
# HTTP listen port. Default 3000.
PORT=3000

# Public identity host. Drives OAuth callbacks, admin UI, and team-invite links.
# Set to YOUR-Railway-domain.up.railway.app or a custom domain (book.example.com)
# AFTER the first deploy, then redeploy. OAuth redirect URIs are computed
# exclusively from this value.
BASE_URL=http://localhost:3000

# SQLite driver. Pure-Go, embedded, no CGO. Keep /data/calnode.db — that
# directory is on a Railway volume (calnode-data) so your calendar,
# availability rules, and bookings survive restarts.
DATABASE_URL=sqlite:///data/calnode.db

# Envelope-encryption master key — REQUIRED for production (https BASE_URL).
# Any non-empty string works; use a strong random value: `openssl rand -hex 32`.
# Rotatable later with `calnode rotate-key`.
CALNODE_ENCRYPTION_KEY=

# ---------------------------------------------------------------- optional --
# Break-glass escrow key for recover-key (set to unlock `calnode recover-key`).
CALNODE_RECOVERY_SECRET=

# Optional booker-facing host (blank = inherits BASE_URL). Set if you want
# public booking links on a different host than your admin UI.
PUBLIC_BASE_URL=

# Timezone for meetings, reminders, log timestamps.
TZ=UTC

# ---- Google OAuth (sign-in + Google Calendar sync) ----
# Create credentials at https://console.cloud.google.com
# Redirect URIs to add:
#   {BASE_URL}/v1/auth/callback
#   {BASE_URL}/v1/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft 365 / Outlook OAuth (sign-in + calendar sync) ----
# Create an Azure App registration. Web redirect URIs:
#   {BASE_URL}/v1/auth/microsoft/callback
#   {BASE_URL}/v1/calendar/callback
# MICROSOFT_TENANT defaults to "common" (personal + work/school). Set to a
# tenant ID to restrict to one organisation.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ---- SMTP (booking emails — optional; blank = emails skipped) ----
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_CONNECT_HOST=
EMAIL_SMTP_CONNECT_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Calnode

# ---- Object storage (Litestream + meeting recordings) — optional ----
# LITESTREAM_REPLICA_URL=s3://your-bucket-name/calnode
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
# LITESTREAM_ENDPOINT=   # required for non-AWS (R2, B2, MinIO)
# LITESTREAM_REGION=
